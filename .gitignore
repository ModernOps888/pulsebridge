# ==========================================
# PulseBridge Git Ignore Configuration
# Comprehensive SecOps & Build Exclusion
# ==========================================

# Rust build outputs
target/
**/*.rs.bk
*.pdb
Cargo.lock

# Node.js & Frontend build outputs
node_modules/
dist/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Secrets, Credentials & Local Configs
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.pfx
secrets/

# PulseBridge Inboxes & Local Telemetry Logs
.inbox/
*.log
*.tmp
*.bak

# Local Screenshots & Image Artifacts (prevent leaking desktop captures)
*.jpg
*.jpeg
*.png
*.bmp
*.gif
!docs/assets/*.png
!docs/assets/*.jpg
!docs/assets/*.svg

# Windows & OS Artifacts
Thumbs.db
desktop.ini
$RECYCLE.BIN/
*.lnk

# IDE & Editor Local State
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/extensions.json
