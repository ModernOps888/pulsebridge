# ==========================================
# PulseBridge Environment Configuration
# ==========================================

# Port for the PulseBridge high-performance Rust server
PULSEBRIDGE_PORT=8080

# Optional custom 6-digit PIN code (if omitted, server generates a dynamic secure PIN on startup)
PULSEBRIDGE_PIN=778899

# Host binding address (0.0.0.0 binds to all local network interfaces)
PULSEBRIDGE_HOST=0.0.0.0

# Optional public tunnel URL (e.g., https://your-tunnel.cfargotunnel.com)
# PULSEBRIDGE_PUBLIC_URL=https://your-domain.com
